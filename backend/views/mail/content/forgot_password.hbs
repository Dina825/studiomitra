<div>
    <table style="box-shadow:box-shadow: 5px 10px #D52B1E;">
        <tr>
            <td>
                <table width="100%" cellpadding="0" cellspacing="0" style="background-repeat:no-repeat;background-size:contain;">
                    <tbody>
                        <tr>
                            <td>
                                <p>Dear {{ username }},</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p>You are receiving this email because we received a password reset request for your account.</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p>
                                    <a href="{{reset_url}}" style="display: inline-block; background-color: #ef403d; color: #ffffff; padding: 5px 20px; border: none; border-radius: 5px; text-align: center; text-decoration: none;">Reset My Password</a>
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p>This password reset link expires in {{ token_expiry_time }} minutes, afterwards you will have to Reset your password again.</p>
                                <p>If you did not request the password to be changed, kindly contact our Customer Support and report this email.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table style="margin-top:3%;">
                    <tr style="font-size: 16px;">
                        <td style="text-align:left;">
                            <p>Regards,</p>
                            <p>{{ app_name }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>