<div>
    <table style="box-shadow:box-shadow: 5px 10px #D52B1E;">
        <tr>
            <th>URL</th>
            <td>{{ url }}</td>
        </tr>
        <tr>
            <th>Message</th>
            <td>{{ message }}</td>
        </tr>
        <tr>
            <th>Stack</th>
            <td>{{ stack }}</td>
        </tr>
        <tr>
            <th>Auth User</th>
            <td>{{ authUser }}</td>
        </tr>
        <tr>
            <th>Query</th>
            <td>{{ inputs.query }}</td>
        </tr>
        <tr>
            <th>Param</th>
            <td>{{ inputs.param }}</td>
        </tr>
        <tr>
            <th>Body</th>
            <td>{{ inputs.body }}</td>
        </tr>
    </table>
</div>